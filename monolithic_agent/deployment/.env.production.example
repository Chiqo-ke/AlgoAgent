# Production environment template for AlgoAgent
# Copy this to /etc/algoagent/.env on your VPS and fill in the values

# ============================================
# DJANGO SETTINGS
# ============================================
DJANGO_SETTINGS_MODULE=algoagent_api.settings_production
DEBUG=False

# Generate a new secret key with:
# python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
DJANGO_SECRET_KEY=your-secret-key-here

# Your domain names (comma-separated)
DJANGO_ALLOWED_HOSTS=your-domain.com,www.your-domain.com

# ============================================
# DATABASE CONFIGURATION
# ============================================
DB_NAME=algoagent
DB_USER=algoagent
DB_PASSWORD=your-secure-database-password
DB_HOST=localhost
DB_PORT=5432

# ============================================
# REDIS CONFIGURATION
# ============================================
REDIS_URL=redis://localhost:6379/0

# ============================================
# CORS & SECURITY
# ============================================
# Frontend domains that can access your API (comma-separated)
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com

# Domains trusted for CSRF (comma-separated)
CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# WebSocket origins (comma-separated, no protocol)
ALLOWED_WEBSOCKET_ORIGINS=your-domain.com,www.your-domain.com

# ============================================
# GOOGLE OAUTH (Optional)
# ============================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ============================================
# LLM CONFIGURATION
# ============================================
LLM_BACKEND=gemini
GOOGLE_API_KEY=your-google-gemini-api-key
GITHUB_TOKEN=your-github-token

# ============================================
# EMAIL CONFIGURATION (Optional)
# ============================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@your-domain.com
ADMIN_EMAIL=admin@your-domain.com
